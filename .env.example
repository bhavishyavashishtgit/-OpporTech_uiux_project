# Gemini API configuration
# Add your Google Generative Language / Gemini API key here.
# Example: VITE_GEMINI_API_KEY=AIza... or your Gemini API key
VITE_GEMINI_API_KEY=AIzaSyCXJ55yGQSSD3TQtkSEn58yRek8W9LlWLU

# Optional: override the Gemini endpoint if needed.
# Default is the official Google Generative Language endpoint for text-bison.
VITE_GEMINI_API_URL=https://generativelanguage.googleapis.com/v1beta2/models/text-bison-001:generate

# Frontend API base URL used by the client when not using Vite proxy.
VITE_API_BASE_URL=http://localhost:4000

# Backend database and authentication.
MONGO_URI=mongodb://localhost:27017/opportech
JWT_SECRET=change_this_secret
