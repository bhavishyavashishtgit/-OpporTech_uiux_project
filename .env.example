# Gemini API configuration
# Add your Google Generative Language / Gemini API key here.
# Get your key from: https://ai.google.dev/
VITE_GEMINI_API_KEY=your_gemini_api_key_here

# Frontend API base URL used by the client when not using Vite proxy.
VITE_API_BASE_URL=http://localhost:4000

# Backend database and authentication (for local development only)
MONGO_URI=mongodb://localhost:27017/opportech
JWT_SECRET=your_jwt_secret_here
